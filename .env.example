
# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY

# Upstash Redis
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Contact IP Hash Secret
CONTACT_IP_HASH_SECRET=YOUR_CONTACT_IP_HASH_SECRET

ANALYTICS_ENABLED=false

# Resend
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_EMAIL=YOUR_NOTIFICATION_EMAIL
NOTIFICATION_FROM_EMAIL=YOUR_NOTIFICATION_FROM_EMAIL

# Github
GITHUB_CONTRIBUTIONS_TOKEN=paste_token_here

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=paste_here
CLOUDFLARE_API_TOKEN=paste_here

# Groq
GROQ_API_KEY=paste_here

# AI chat ("Ask"). Server-only; the chat stays hidden and /api/chat returns 503 unless "true".
# Uses the Groq, Cloudflare, Supabase public, Upstash and CONTACT_IP_HASH_SECRET values above.
CHAT_ENABLED=false
